# Verified names from noqui/web/src/main.rs. This file contains paths, no secret.
# Install as /etc/noqui/noqui.env (root:ubuntu 0640).
# Public 127.0.0.1:8787 and bridge 127.0.0.1:8788 are compiled in the binary.
NOQUI_BRIDGE_SECRET_FILE=/etc/noqui/bridge.key
NOQUI_KEY_ID=primary
NOQUI_DATA_DIR=/var/lib/noqui
NOQUI_YT_DLP=/opt/noqui/current/yt-dlp-private-cookies.sh
# Dedicated Noqui runtime; do not replace the Moma downloader environment.
NOQUI_YT_DLP_REAL=/opt/noqui/tools/yt-dlp-2026.10.26/bin/yt-dlp
NOQUI_FFMPEG=/usr/bin/ffmpeg
NOQUI_FFPROBE=/usr/bin/ffprobe
NOQUI_YOUTUBE_COOKIES_FILE=/home/ubuntu/mc-luck-defense/secrets/youtube-cookies.txt
