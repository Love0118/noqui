# Final DNS-only website vhost. Enable only AFTER HTTP-01 certificate issuance.
# Replace the HTTP-only bootstrap vhost; do not enable both files together.
# Existing HAProxy, chat mirror, resource-pack and Minecraft routes are separate.
log_format noqui_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name noqui.danta.qzz.io;
    access_log /var/log/nginx/noqui-access.log noqui_safe;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://noqui.danta.qzz.io$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name noqui.danta.qzz.io;
    access_log /var/log/nginx/noqui-access.log noqui_safe;
    ssl_certificate /etc/letsencrypt/live/noqui.danta.qzz.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/noqui.danta.qzz.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:NOQUI_TLS:1m;
    ssl_session_timeout 1d;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    # The HMAC bridge is loopback :8788 and is never a proxy upstream.
    location = /internal { return 404; }
    location ^~ /internal/ { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host noqui.danta.qzz.io;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        # Preserve event streaming and authenticated range responses from Rust.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
    }
}
